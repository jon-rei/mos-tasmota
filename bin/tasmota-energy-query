#!/bin/bash
# tasmota-energy-query - poll Tasmota devices for energy metrics.
#
# Called by the tasmota-energy MOS plugin frontend through
#   POST /api/v1/mos/plugins/query  {command: "tasmota-energy-query", args: [], ...}
# which only executes binaries located in /usr/bin/plugins/.
#
# Usage:
#   tasmota-energy-query                       poll all devices from settings.json
#   tasmota-energy-query <ip> [user password]   poll a single device (connection test)
#
# Output: one JSON object on stdout:
#   {
#     "ok": true,
#     "devices": [
#       { "name", "ip", "ok", "error",
#         "power", "apparent_power", "reactive_power", "factor",
#         "voltage", "current", "today", "yesterday", "total", "period" }
#     ],
#     "totals": { "power", "apparent_power", "reactive_power",
#                 "today", "yesterday", "total" }
#   }
# A missing settings file (nothing saved yet) yields an empty device list.
# On a hard failure: { "ok": false, "error": "<code>" }
#
# Errors are short codes, translated by the frontend (locales "errors"):
#   per device:  unreachable, auth_failed, no_energy
#   hard:        missing_jq, missing_curl, settings_invalid, tmpdir_failed
#
# Always exits 0 so the query API reports success and the frontend gets
# the structured error instead of a bare exit code.
#
# Requires: bash, curl, jq (declared as .deb Depends).

set -u

SETTINGS="${TASMOTA_ENERGY_SETTINGS:-/boot/optional/plugins/tasmota-energy/settings.json}"
CURL_TIMEOUT=5
CURL_CONNECT_TIMEOUT=3

uri() { printf '%s' "$1" | jq -Rr @uri; }

# $1 is one of the error codes above (plain identifier, so printf is safe
# and works even when jq itself is missing).
fail() {
  printf '{"ok":false,"error":"%s"}\n' "$1"
  exit 0
}

empty_result() {
  jq -cn '{ok: true, devices: [], totals: {power: 0, apparent_power: 0, reactive_power: 0, today: 0, yesterday: 0, total: 0}}'
  exit 0
}

command -v jq >/dev/null 2>&1 || fail missing_jq
command -v curl >/dev/null 2>&1 || fail missing_curl

# Poll one device. Writes the per-device result JSON to the file given as $5.
#   poll <name> <ip> <user> <password> <outfile>
poll() {
  local name="$1" ip="$2" user="$3" pass="$4" out="$5"
  local url="http://${ip}/cm?"
  if [ -n "$user" ] || [ -n "$pass" ]; then
    url="${url}user=$(uri "$user")&password=$(uri "$pass")&"
  fi
  url="${url}cmnd=Status%208"

  local body
  if ! body=$(curl --silent --show-error -m "$CURL_TIMEOUT" \
                   --connect-timeout "$CURL_CONNECT_TIMEOUT" "$url" 2>/dev/null); then
    jq -cn --arg name "$name" --arg ip "$ip" \
      '{name: $name, ip: $ip, ok: false, error: "unreachable"}' > "$out"
    return
  fi

  # Tasmota answers wrong/missing credentials with
  # {"WARNING":"Need user=<username>&password=<password>"}.
  local error=""
  if jq -e 'type == "object" and has("WARNING")' >/dev/null 2>&1 <<<"$body"; then
    error="auth_failed"
  elif ! jq -e '.StatusSNS.ENERGY | type == "object"' >/dev/null 2>&1 <<<"$body"; then
    error="no_energy"
  fi
  if [ -n "$error" ]; then
    jq -cn --arg name "$name" --arg ip "$ip" --arg error "$error" \
      '{name: $name, ip: $ip, ok: false, error: $error}' > "$out"
    return
  fi

  # Multi-channel devices (e.g. Shelly 2.5, SetOption129) report arrays per
  # channel: sum additive values, average voltage and power factor.
  jq -cn --arg name "$name" --arg ip "$ip" --argjson body "$body" '
    def sum: if type == "array" then (map(numbers) | add) else . end;
    def avg: if type == "array" then (map(numbers) | if length > 0 then add / length else null end) else . end;
    $body.StatusSNS.ENERGY as $e |
    {
      name: $name,
      ip: $ip,
      ok: true,
      power: ($e.Power | sum),
      apparent_power: ($e.ApparentPower | sum),
      reactive_power: ($e.ReactivePower | sum),
      factor: ($e.Factor | avg),
      voltage: ($e.Voltage | avg),
      current: ($e.Current | sum),
      today: ($e.Today | sum),
      yesterday: ($e.Yesterday | sum),
      total: ($e.Total | sum),
      period: ($e.Period | sum)
    }' > "$out"
}

# Collect the devices to poll: either the single device given as arguments
# (connection test from the settings page) or all devices from settings.json.
declare -a NAMES=() IPS=() USERS=() PASSES=()
if [ $# -ge 1 ]; then
  NAMES+=("test")
  IPS+=("$1")
  USERS+=("${2:-}")
  PASSES+=("${3:-}")
else
  # No settings file yet just means nothing has been saved: no devices.
  [ -f "$SETTINGS" ] || empty_result
  if ! jq -e 'has("devices")' >/dev/null 2>&1 <"$SETTINGS"; then
    fail settings_invalid
  fi
  # One NUL-terminated record per device, fields separated by \x1f. Unlike
  # @tsv with IFS=$'\t' (tab is IFS whitespace, so empty fields collapse),
  # this keeps empty fields in place and passes values through unescaped.
  while IFS=$'\x1f' read -r -d '' name ip user pass; do
    [ -n "$ip" ] || continue
    NAMES+=("${name:-$ip}")
    IPS+=("$ip")
    USERS+=("$user")
    PASSES+=("$pass")
  done < <(jq -j '.devices[] | [(.name // ""), (.ip // ""), (.user // ""), (.password // "")] | map(tostring) | join("\u001f") + "\u0000"' "$SETTINGS")
fi

[ "${#IPS[@]}" -eq 0 ] && empty_result

TMPDIR_POLL=$(mktemp -d) || fail tmpdir_failed
trap 'rm -rf "$TMPDIR_POLL"' EXIT

# Poll all devices in parallel so one slow/unreachable device does not
# delay the others (each curl is bounded by its own timeout anyway).
for i in "${!IPS[@]}"; do
  poll "${NAMES[$i]}" "${IPS[$i]}" "${USERS[$i]}" "${PASSES[$i]}" "$TMPDIR_POLL/$i.json" &
done
wait

# Merge per-device results and compute totals across the reachable ones.
jq -s '
  {
    ok: true,
    devices: .,
    totals: (
      [.[] | select(.ok == true)] as $up |
      {
        power: ([$up[] | .power // 0] | add // 0),
        apparent_power: ([$up[] | .apparent_power // 0] | add // 0),
        reactive_power: ([$up[] | .reactive_power // 0] | add // 0),
        today: ([$up[] | .today // 0] | add // 0),
        yesterday: ([$up[] | .yesterday // 0] | add // 0),
        total: ([$up[] | .total // 0] | add // 0)
      }
    )
  }' "$TMPDIR_POLL"/*.json
